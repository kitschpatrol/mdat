{
	"name": "mdat",
	"version": "3.6.1",
	"description": "CLI tool and TypeScript library to turn comments into content in Markdown files. MDAT makes it easy to generate and update dynamic boilerplate in project readmes.",
	"keywords": [
		"mdat",
		"markdown",
		"template",
		"readme",
		"comments",
		"docs-generator",
		"docs",
		"cli",
		"npm-package"
	],
	"homepage": "https://github.com/kitschpatrol/mdat",
	"bugs": "https://github.com/kitschpatrol/mdat/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/mdat.git"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/lib/index.d.ts",
			"import": "./dist/lib/index.js"
		}
	},
	"main": "./dist/lib/index.js",
	"module": "./dist/lib/index.js",
	"types": "./dist/lib/index.d.ts",
	"bin": {
		"mdat": "dist/bin/cli.js"
	},
	"files": [
		"dist/*",
		"skills/*"
	],
	"scripts": {
		"bench": "vitest bench --run --reporter=default",
		"bench:baseline": "vitest bench --run --reporter=default",
		"build": "tsdown",
		"clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX -e !.claude/",
		"coverage": "vitest --coverage --run",
		"fix": "ksc fix",
		"lint": "ksc lint",
		"prepare": "skills experimental_sync -y -f",
		"release": "bumpp --commit 'Release: %s' && pnpm build && pnpm publish --otp $(op item get npm --otp) && brewpub --tap kitschpatrol/tap",
		"test": "vitest run"
	},
	"dependencies": {
		"@clack/prompts": "^1.8.1",
		"cosmiconfig": "^10.0.1",
		"cosmiconfig-typescript-loader": "^6.3.0",
		"deepmerge-ts": "^8.0.2",
		"globby": "^16.2.4",
		"gray-matter-es": "^0.2.1",
		"lognow": "^0.8.5",
		"mdast-util-toc": "^7.1.0",
		"metascope": "^0.12.2",
		"path-type": "^6.0.0",
		"picocolors": "^1.1.1",
		"plur": "^6.0.0",
		"pretty-bytes": "^7.2.0",
		"pretty-ms": "^9.3.1",
		"remark": "^15.0.1",
		"remark-gfm": "^4.0.1",
		"remark-mdat": "^3.1.1",
		"to-vfile": "^8.0.0",
		"type-fest": "^5.10.0",
		"unified-engine": "^11.2.2",
		"untildify": "^6.0.0",
		"vfile": "^6.0.3",
		"yargs": "^18.2.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@arethetypeswrong/core": "^0.18.5",
		"@kitschpatrol/shared-config": "^8.12.1",
		"@types/mdast": "^4.0.4",
		"@types/node": "~24.13.6",
		"@types/unist": "^3.0.3",
		"@types/yargs": "^17.0.35",
		"@vitest/coverage-v8": "^5.0.3",
		"brewpub": "^0.5.0",
		"bumpp": "^12.3.0",
		"execa": "^10.0.1",
		"mdat-plugin-cli-help": "^3.4.0",
		"mdat-plugin-example": "^3.0.0",
		"mdat-plugin-tldraw": "^3.0.0",
		"nanoid": "^6.0.2",
		"prettier": "^3.9.9",
		"publint": "^0.3.25",
		"shx": "^0.4.0",
		"skills": "^1.7.0",
		"tsdown": "^0.23.0",
		"typescript": "~6.0.3",
		"unplugin-raw": "^0.8.0",
		"vitest": "^5.0.3"
	},
	"peerDependencies": {
		"prettier": "^3.0.0"
	},
	"peerDependenciesMeta": {
		"prettier": {
			"optional": true
		}
	},
	"packageManager": "pnpm@12.9.1",
	"engines": {
		"node": "^24.16.0 || >=26.3.0"
	}
}
